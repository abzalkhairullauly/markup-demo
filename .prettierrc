{
    "tabWidth": 4,
    "printWidth": 80,
    "singleQuote": false,
    "trailingComma": "all",
    "overrides": [
        {
            "files": "*.html",
            "options": { "parser": "angular" }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
